{
  "name": "linea-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host",
    "typecheck": "tsc --noEmit",
    "deploy": "vite build && wrangler pages deploy dist --project-name=lineaapp",
    "pages:create": "wrangler pages project create lineaapp --production-branch=main",
    "pages:deploy": "wrangler pages deploy dist --project-name=lineaapp"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5",
    "vite": "^6.3.5",
    "wrangler": "^4.155.0"
  }
}
